#!/usr/bin/env bash
# nextest's run-wrapper for the guest tests (.config/nextest.toml): `run-in-guest MODE TEST-BINARY
# ARGS...` runs one test (nextest's ARGS: `--exact <name> --nocapture`) in a sandbox of its own.
#
# --ro takes directories, and the binary's own (target/<profile>/deps) holds every test
# binary and rlib of the workspace. So the binary is hard-linked into a directory of its own,
# target/<profile>/guest-tests/<binary>/, and only that is allowed; its closure (glibc,
# libgcc_s) unsharek finds from its store references.
#
# One directory per binary, not per test: unsharek copies an allowed host directory into an erofs
# image, cached under the directory's path and a key of its metadata (inode, link count, mtime).
# A directory per test built a 3 MB image per test (~100 ms) and left each in the cache; and
# hard-linking the one binary into many directories at once changed its link count under the
# others' image builds ("kept changing while its image was built"). So the link is made (or
# remade, after a rebuild) under a lock, and the first test of each build builds the image for
# all of them (`--list` in the guest, under the lock).
set -uo pipefail
mode=$1 bin=$2
shift 2
# Canonical: an allowed path is shown in the guest at the path given, and deps/.. there would be
# a walk through a directory the guest hasn't.
profile=$(realpath "$(dirname "$bin")/..")
unsharek=$profile/unsharek
if [[ ! -x $unsharek ]]; then
  echo "run-in-guest: no unsharek binary at $unsharek (build the workspace: cargo xtask test)" >&2
  exit 125
fi
name=${bin##*/}
dir=$profile/guest-tests/$name
link=$dir/$name
mkdir -p "$dir"
{
  flock 9
  if [[ ! $link -ef $bin ]]; then
    ln -f "$bin" "$link.new" && mv -f "$link.new" "$link" || exit 125
    # The image, built once for the binary's tests (and the binary seen to start in the guest).
    out=$("$unsharek" --mode "$mode" --ro "$dir" -- "$link" --list 2>&1)
    st=$?
    if ((st != 0)); then
      rm -f "$link"
      printf 'run-in-guest: %s --list in the guest: status %d\n%s\n' "$name" "$st" "$out" >&2
      exit 125
    fi
  fi
} 9>"$dir.lock"
export UNSHAREK_TEST_MODE=$mode
# The sandbox's environment is empty but for what's kept: here all of this one's (nextest's and
# the harness's variables, which the tests' natively run selves see too).
keep=()
while IFS= read -r -d '' kv; do keep+=(--keep-env "${kv%%=*}"); done < <(env -0)
exec "$unsharek" --mode "$mode" --ro "$dir" "${keep[@]}" -- "$link" "$@"
