+int lkl_net_done_fd(void *sock, long fd)
+{
+	struct sock *sk = sock;
+	struct tsi_sock *tsk = tsi_sk(sk);
+	int err = 0;
+
+	if (fd < 0 || sk->sk_type != SOCK_STREAM)
+		return -EINVAL;
+	err = tsi_enter();
+	if (err)
+		return err;
+	lock_sock(sk);
+	if (tsk->conn != TSI_CONNECTING) {
+		err = -EINVAL;
+	} else if (tsk->released) {
+		/* the program gave up: the host keeps fd */
+		tsk->conn = TSI_NONE;
+		err = -ECONNABORTED;
+	} else {
+		tsk->hosted = true;
+		tsk->hostfd = fd;
+		tsk->conn = TSI_CONNECTED;
+		sk->sk_socket->state = SS_CONNECTED;
+		sk->sk_state = TCP_ESTABLISHED;
+	}
+	tsi_wake(tsk);
+	release_sock(sk);
+	sock_put(sk);
+	tsi_leave();
+	return err;
+}
+
+int lkl_net_accept_fd(void *sock, const struct sockaddr *peer, int len,
+		      long fd)
+{
+	struct sock *sk = sock;
+	struct tsi_sock *tsk = tsi_sk(sk);
+	struct tsi_pending *p;
+	int err;
+
+	if (fd < 0 || len < (int)sizeof(struct sockaddr_in))
+		return -EINVAL;
+	err = tsi_enter();
+	if (err)
+		return err;
+	p = kzalloc(sizeof(*p), GFP_KERNEL);
+	err = -ENOMEM;
+	if (!p)
+		goto out;
+	lock_sock(sk);
+	if (tsk->released || !tsk->host_listening ||
+	    tsk->npending >= max(tsk->backlog, 1)) {
+		release_sock(sk);
+		kfree(p);
+		err = -ECONNREFUSED;
+		goto out;
+	}
+	p->hosted = true;
+	p->hostfd = fd;
+	memcpy(&p->peer, peer, sizeof(p->peer));
+	p->peer.sin_family = AF_INET;
+	list_add_tail(&p->list, &tsk->pending);
+	tsk->npending++;
+	tsi_wake(tsk);
+	release_sock(sk);
+	err = 0;
+out:
+	tsi_leave();
+	return err;
+}
