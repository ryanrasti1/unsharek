#!/usr/bin/env bash
# The vs-native suite (native/bench/quick.py): enters the devshell, builds exobox and the fixtures
# release, runs. `./test --vs-native` comes here. Arguments go to quick.py.
set -euo pipefail
root="$(cd "$(dirname "$0")/../.." && pwd)"
# shellcheck source=../../devshell.sh
source "$root/devshell.sh"
cd "$root"
cargo build --release -q -p exobox --bin exobox -p exobox-fixtures
exec python3 "$root/native/bench/quick.py" "$@"
