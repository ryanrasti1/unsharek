#!/usr/bin/env bash
# The build benchmarks (bench/build_bench.py): enters the devshell, builds unsharek release,
# runs. Arguments go to build_bench.py, e.g.:
#   bench/run --work rustc,xz --modes native,coroutine,threaded --reps 3
#   bench/run --work make,cargo --modes native,fork
#   bench/run --work rustc --modes native,fork,fork:stats --variant stats   (the counters)
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=../devshell.sh
source "$root/devshell.sh"
cd "$root"
# shellcheck source=build_unsharek.sh
source "$root/native/bench/build_unsharek.sh"
build_unsharek "$@"
exec python3 "$root/native/bench/build_bench.py" "$@"
