#!/usr/bin/env bash
# The vs-native suite (bench/quick.py): enters the devshell, builds unsharek and the fixtures
# release (and the counters' build for `--variant stats`), runs. `./test --vs-native` comes here.
# Arguments go to quick.py.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=../devshell.sh
source "$root/devshell.sh"
cd "$root"
# shellcheck source=build_unsharek.sh
source "$root/native/bench/build_unsharek.sh"
build_unsharek "$@"
cargo build --release -q -p unsharek-fixtures
exec python3 "$root/native/bench/quick.py" "$@"
