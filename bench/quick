#!/usr/bin/env bash
# The vs-native suite (bench/quick.py), in the devshell (direnv, or `nix develop -c`): builds
# unsharek and the fixtures release (and the counters' build for `--variant stats`), runs.
# `cargo xtask vs-native` comes here.
# Arguments go to quick.py.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"
# shellcheck source=build_unsharek.sh
source "$root/bench/build_unsharek.sh"
build_unsharek "$@"
cargo build --release -q -p unsharek-fixtures
exec python3 "$root/bench/quick.py" "$@"
