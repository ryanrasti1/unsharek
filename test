#!/usr/bin/env bash
# Build incrementally and run every test: the unit tests, the in-guest tests (native/guest-tests:
# a sandbox per test) and the host-side suite (native/exobox/tests/suite.rs), natively and in each
# mode. Seconds, warm. Arguments go to cargo-nextest, e.g.:
#   ./test -E 'test(/::fork$/)'      one mode of the suite
#   ./test -E 'binary(guest_fork)'   the in-guest tests in fork mode
#   ./test -E 'test(/^escape/)'      the filter's cases
#   ./test --no-fail-fast            (the default stops at the first failure)
#   ./test --perf                    the performance budgets instead (tests/perf.rs; tens of seconds)
#   ./test --vs-native               each mode against native on build workloads (native/bench/quick.py)
#   ./test --prove                   Kani's proofs: each policy! harness, a policy function equal
#                                    to its compiled program (seccomp-fn's examples, unsharek-tcb's
#                                    filter, a harness per mode); minutes
set -euo pipefail
root="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=devshell.sh
source "$root/devshell.sh"
cd "$root"
if [[ "${1:-}" == --prove ]]; then
  shift
  # -j: the harnesses in parallel (one per mode and shape; each a minute or two alone)
  cargo kani --manifest-path seccomp-fn/Cargo.toml -p seccomp-fn --tests -j --output-format=terse "$@"
  exec cargo kani -p exobox-tcb -j --output-format=terse "$@"
fi
if [[ "${1:-}" == --vs-native ]]; then
  # Where each mode stands against native on the workloads that matter, in seconds
  # (native/bench/quick.py); not a correctness test.
  shift
  exec "$root/native/bench/quick" "$@"
fi
profile=default
build=()
if [[ "${1:-}" == --perf ]]; then
  # The budgets are release numbers (capnix tier A measured release builds), so measure release.
  profile=perf
  build=(--release)
  shift
fi
cargo nextest run --workspace --no-tests=warn --profile "$profile" "${build[@]}" "$@"
# seccomp-fn, its own workspace (its fast checks, and run_bpf against the kernel), unless a filter
# picked other tests
if [[ $profile == default && $# == 0 ]]; then
  exec cargo nextest run --manifest-path seccomp-fn/Cargo.toml --workspace --no-tests=warn
fi
